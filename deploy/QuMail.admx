<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="qumail" namespace="QuMail.Policies" />
    <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <categories>
    <category name="QuMailCategory" displayName="$(string.QuMailCategory)" />
    <category name="SecurityCategory" displayName="$(string.SecurityCategory)">
      <parentCategory ref="QuMailCategory" />
    </category>
    <category name="UpdatesCategory" displayName="$(string.UpdatesCategory)">
      <parentCategory ref="QuMailCategory" />
    </category>
  </categories>
  <policies>
    <!-- Policy: Block External Accounts -->
    <policy name="BlockExternalAccounts" class="Machine" displayName="$(string.BlockExternalAccounts)" explainText="$(string.BlockExternalAccounts_Explain)" key="SOFTWARE\Policies\QuMail" valueName="block_external_accounts">
      <parentCategory ref="SecurityCategory" />
      <supportedOn ref="windows:SUPPORTED_Windows10" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- Policy: Enforce Strict Post-Quantum Encryption -->
    <policy name="EnforceStrictEncryption" class="Machine" displayName="$(string.EnforceStrictEncryption)" explainText="$(string.EnforceStrictEncryption_Explain)" key="SOFTWARE\Policies\QuMail" valueName="enforce_strict_encryption">
      <parentCategory ref="SecurityCategory" />
      <supportedOn ref="windows:SUPPORTED_Windows10" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- Policy: Disable Legacy Simulator -->
    <policy name="DisableLegacySimulator" class="Machine" displayName="$(string.DisableLegacySimulator)" explainText="$(string.DisableLegacySimulator_Explain)" key="SOFTWARE\Policies\QuMail" valueName="disable_legacy_simulator">
      <parentCategory ref="SecurityCategory" />
      <supportedOn ref="windows:SUPPORTED_Windows10" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- Policy: Update Channel Selection -->
    <policy name="UpdateChannel" class="Machine" displayName="$(string.UpdateChannel)" explainText="$(string.UpdateChannel_Explain)" presentation="$(presentation.UpdateChannel)" key="SOFTWARE\Policies\QuMail">
      <parentCategory ref="UpdatesCategory" />
      <supportedOn ref="windows:SUPPORTED_Windows10" />
      <elements>
        <enum id="UpdateChannelEnum" valueName="update_channel">
          <item displayName="$(string.UpdateChannel_Prod)"><value><string>Production</string></value></item>
          <item displayName="$(string.UpdateChannel_LTS)"><value><string>LTS</string></value></item>
          <item displayName="$(string.UpdateChannel_Beta)"><value><string>Beta</string></value></item>
        </enum>
      </elements>
    </policy>
  </policies>
</policyDefinitions>
